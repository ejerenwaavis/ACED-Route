# Copy this file to .env and fill in real values. Never commit .env.

# --- Mongo: ONE database, shared by BarcodeTool, SmartStop, RoutingAssistant, ACED Route ---
MONGODB_URI=

# --- JWT ---
JWT_SECRET=

# --- Google OAuth (Web application client — matches what you already created) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Cloud Console
GOOGLE_CALLBACK_URL=https://route.aceddivision.com/api/auth/googleLoggedIn

# --- Google Maps / Navigation / Geocoding ---
GOOGLE_MAPS_API_KEY=

# --- Mobile deep link scheme (must match mobile/capacitor.config.json) ---
MOBILE_APP_SCHEME=acedroute

PORT=3000
